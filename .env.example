# Copy to .env to use. Everything here is optional - the web page asks for what it needs.

# Pre-connect Claude (otherwise do it on the page; secrets entered there are kept in memory only).
# Claude account (Pro / Max / Team / Enterprise) - create the token with:  claude setup-token
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# or a pay-per-use Claude API key from console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Use your own External Client App instead of the Salesforce CLI connected app (PlatformCLI),
# e.g. when the org blocks uninstalled connected apps. Its callback URL must be exactly SF_CALLBACK_URL.
# SF_CLIENT_ID=3MVG9...
# SF_CLIENT_SECRET=
# SF_CALLBACK_URL=http://localhost:1717/OauthRedirect

# Maximum release notes upload size in MB
# RC_MAX_UPLOAD_MB=200
